@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi hệ thống";
}

<h1 class="text-danger">Đã xảy ra lỗi.</h1>
<h2 class="text-danger">Có sự cố trong quá trình xử lý yêu cầu của bạn.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu (Request ID):</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển (Development Mode)</h3>
<p>
    Chuyển sang môi trường <strong>Development</strong> sẽ hiển thị thông tin chi tiết hơn về lỗi đã xảy ra.
</p>
<p>
    <strong>Không nên bật môi trường Development cho các ứng dụng đã triển khai thực tế.</strong>
    Việc này có thể hiển thị thông tin nhạy cảm từ các ngoại lệ cho người dùng.
    Để gỡ lỗi cục bộ, hãy bật môi trường <strong>Development</strong> bằng cách đặt biến môi trường <strong>ASPNETCORE_ENVIRONMENT</strong> thành <strong>Development</strong>
    và khởi động lại ứng dụng.
</p>
