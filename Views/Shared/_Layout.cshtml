<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ushi Mania POS</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kitchen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/qr-modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/UshiMania.styles.css" asp-append-version="true" />
    <style>
        .pos-user-badge {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-right: 14px;
            background: rgba(255, 255, 255, 0.1);
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 13px;
        }
        .pos-role-tag {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 3px;
            text-transform: uppercase;
        }
        .role-quanly { background-color: #dc3545; color: #fff; }
        .role-phucvu { background-color: #0d6efd; color: #fff; }
        .role-thungan { background-color: #198754; color: #fff; }
        .role-bep { background-color: #ffc107; color: #000; }
        .btn-pos-logout {
            color: #ffc9c9;
            border: 1px solid rgba(255, 200, 200, 0.4);
            background: transparent;
            font-size: 11.5px;
            padding: 2px 8px;
            border-radius: 3px;
            text-decoration: none;
            transition: all 0.15s;
        }
        .btn-pos-logout:hover {
            color: #fff;
            background: #dc3545;
            border-color: #dc3545;
        }

        /* Kiểu dáng cho các menu bị phân quyền (vẫn hiện nhưng không bấm vào được) */
        .pos-nav-link.pos-disabled {
            opacity: 0.42;
            cursor: not-allowed !important;
            background: rgba(0, 0, 0, 0.22) !important;
            color: #9aa0a6 !important;
            border: 1px dashed rgba(255, 255, 255, 0.2);
            box-shadow: none !important;
            user-select: none;
        }
        .pos-nav-link.pos-disabled:hover {
            background: rgba(0, 0, 0, 0.35) !important;
            color: #adb5bd !important;
            box-shadow: none !important;
        }
        .pos-nav-lock {
            font-size: 11.5px;
            margin-left: 4px;
            opacity: 0.85;
        }
    </style>
</head>
<body class="pos-shell">
    @{
        var currentTitle = ViewData["Title"]?.ToString() ?? "";
        // Định nghĩa quyền hạn:
        // Quản lý: Tất cả
        // Phục vụ: Sơ đồ bàn, Order POS
        // Thu ngân: Sơ đồ bàn, Order POS, Kho & Báo cáo
        // Bếp: Bếp KDS, Kho & Báo cáo
        var canAccessSoDoBan = User.IsInRole("QUAN_LY") || User.IsInRole("PHUC_VU") || User.IsInRole("THU_NGAN");
        var canAccessOrderPOS = User.IsInRole("QUAN_LY") || User.IsInRole("PHUC_VU") || User.IsInRole("THU_NGAN");
        var canAccessBep = User.IsInRole("QUAN_LY") || User.IsInRole("BEP");
        var canAccessKho = User.IsInRole("QUAN_LY") || User.IsInRole("THU_NGAN") || User.IsInRole("BEP");
    }

    <header class="pos-header">
        <a class="pos-brand" asp-area="" asp-controller="Home" asp-action="@(User.IsInRole("BEP") ? "ManHinhBep" : "SoDoBan")" aria-label="Ushi Mania">
            <span class="pos-brand-mark">UM</span>
            <span>Ushi <strong>Mania</strong></span>
        </a>

        <!-- Điều hướng POS: Luôn hiển thị đầy đủ, tab không đủ quyền sẽ bị khóa (không bấm được) -->
        <nav class="pos-quick-nav" aria-label="Điều hướng POS">
            @* 1. Sơ đồ bàn: Quản lý, Phục vụ, Thu ngân được bấm *@
            @if (canAccessSoDoBan)
            {
                <a class="pos-nav-link @(currentTitle == "Sơ đồ bàn" ? "active" : string.Empty)" asp-controller="Home" asp-action="SoDoBan">Sơ đồ bàn</a>
            }
            else
            {
                <a class="pos-nav-link pos-disabled" href="javascript:void(0)" onclick="notifyNoPermission('Sơ đồ bàn')" title="Bạn không có quyền truy cập Sơ đồ bàn" tabindex="-1">
                    Sơ đồ bàn <span class="pos-nav-lock">🔒</span>
                </a>
            }

            @* 2. Order POS: Quản lý, Phục vụ, Thu ngân được bấm *@
            @if (canAccessOrderPOS)
            {
                <a class="pos-nav-link @(currentTitle == "Order POS" ? "active" : string.Empty)" asp-controller="Home" asp-action="OrderPOS">Order POS</a>
            }
            else
            {
                <a class="pos-nav-link pos-disabled" href="javascript:void(0)" onclick="notifyNoPermission('Order POS')" title="Bạn không có quyền truy cập Order POS" tabindex="-1">
                    Order POS <span class="pos-nav-lock">🔒</span>
                </a>
            }

            @* 3. Bếp KDS: Quản lý, Bếp được bấm *@
            @if (canAccessBep)
            {
                <a class="pos-nav-link @(currentTitle == "Bếp KDS" ? "active" : string.Empty)" asp-controller="Home" asp-action="ManHinhBep">Bếp KDS</a>
            }
            else
            {
                <a class="pos-nav-link pos-disabled" href="javascript:void(0)" onclick="notifyNoPermission('Bếp KDS')" title="Bạn không có quyền truy cập Màn hình Bếp KDS" tabindex="-1">
                    Bếp KDS <span class="pos-nav-lock">🔒</span>
                </a>
            }

            @* 4. Kho & Báo cáo: Quản lý, Thu ngân, Bếp được bấm *@
            @if (canAccessKho)
            {
                <a class="pos-nav-link @(currentTitle == "Kho & Báo cáo" ? "active" : string.Empty)" asp-controller="Home" asp-action="KhoBaoCao">Kho &amp; Báo cáo</a>
            }
            else
            {
                <a class="pos-nav-link pos-disabled" href="javascript:void(0)" onclick="notifyNoPermission('Kho & Báo cáo')" title="Bạn không có quyền truy cập Kho & Báo cáo" tabindex="-1">
                    Kho &amp; Báo cáo <span class="pos-nav-lock">🔒</span>
                </a>
            }
        </nav>

        <!-- Thông tin nhân sự đăng nhập & Giờ hệ thống -->
        <div class="d-flex align-items-center">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var roleClass = User.IsInRole("QUAN_LY") ? "role-quanly"
                              : User.IsInRole("PHUC_VU") ? "role-phucvu"
                              : User.IsInRole("THU_NGAN") ? "role-thungan"
                              : User.IsInRole("BEP") ? "role-bep" : "bg-secondary text-white";

                var roleLabel = User.IsInRole("QUAN_LY") ? "Quản lý"
                              : User.IsInRole("PHUC_VU") ? "Phục vụ"
                              : User.IsInRole("THU_NGAN") ? "Thu ngân"
                              : User.IsInRole("BEP") ? "Đầu bếp" : "Nhân viên";

                <div class="pos-user-badge">
                    <span class="pos-role-tag @roleClass">@roleLabel</span>
                    <span class="text-white fw-bold d-none d-sm-inline" title="Nhân viên đang đăng nhập">@User.Identity.Name</span>
                    <a asp-controller="Home" asp-action="Logout" class="btn-pos-logout" title="Đăng xuất / Khóa màn hình POS">
                        Đăng xuất
                    </a>
                </div>
            }
            else
            {
                <div style="margin-right: 12px;">
                    <a asp-controller="Home" asp-action="DangNhap" class="btn btn-danger btn-sm py-1 px-3 fw-bold">
                        Đăng nhập POS
                    </a>
                </div>
            }

            <div class="pos-clock" aria-label="Giờ hiện tại">
                <span>Giờ hiện tại</span>
                <time id="current-time">--:--:--</time>
            </div>
        </div>
    </header>

    <main role="main" class="pos-main">
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Cập nhật đồng hồ thời gian thực
        (() => {
            const clock = document.getElementById('current-time');
            const updateClock = () => clock.textContent = new Intl.DateTimeFormat('vi-VN', {
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            }).format(new Date());
            updateClock();
            window.setInterval(updateClock, 1000);
        })();

        // Thông báo khi nhấp vào menu bị khóa quyền
        function notifyNoPermission(featureName) {
            let toast = document.getElementById('pos-perm-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'pos-perm-toast';
                toast.style.cssText = 'position:fixed;top:55px;left:50%;transform:translateX(-50%);background:#b02a37;color:#fff;padding:8px 18px;border-radius:20px;font-size:13px;font-weight:600;z-index:99999;box-shadow:0 4px 15px rgba(0,0,0,0.35);display:flex;align-items:center;gap:8px;border:1px solid #f5c2c7;';
                document.body.appendChild(toast);
            }
            toast.innerHTML = '🔒 Tài khoản của bạn không có quyền truy cập vào <b>' + featureName + '</b>';
            toast.style.display = 'flex';
            clearTimeout(window.permToastTimer);
            window.permToastTimer = setTimeout(() => { toast.style.display = 'none'; }, 2500);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
