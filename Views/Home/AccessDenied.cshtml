@{
    ViewData["Title"] = "Không đủ quyền truy cập";
    var role = User.IsInRole("QUAN_LY") ? "Quản lý"
             : User.IsInRole("PHUC_VU") ? "Nhân viên phục vụ"
             : User.IsInRole("THU_NGAN") ? "Thu ngân"
             : User.IsInRole("BEP") ? "Đầu bếp" : "Chưa xác định";
}

<div class="khung-tu-choi-truy-cap container py-5 text-center">
    <div class="hang-chua-the row justify-content-center">
        <div class="cot-noi-dung col-md-7 col-lg-6">
            <div class="the-canh-bao-quyen card shadow-sm border-0 p-4" style="background-color: #2b2d31; color: #fff; border-radius: 8px;">
                <div class="bieu-tuong-canh-bao mb-3">
                    <span style="font-size: 52px;">🚫</span>
                </div>
                <h3 class="tieu-de-tu-choi fw-bold text-danger mb-2">Truy Cập Bị Từ Chối</h3>
                <p class="dong-giai-thich-quyen text-secondary mb-4" style="font-size: 15px;">
                    Tài khoản của bạn (<strong class="text-white">@User.Identity?.Name</strong> - <span class="badge bg-danger">@role</span>) không được phân quyền để truy cập trang này.
                </p>

                <div class="hop-quy-dinh-quyen p-3 mb-4 text-start" style="background: rgba(255,255,255,0.05); border-radius: 6px; font-size: 13.5px; border-left: 3px solid #ffc107;">
                    <div class="tieu-de-quy-dinh fw-bold text-warning mb-2">Quy định phân quyền hệ thống POS Ushi Mania:</div>
                    <ul class="danh-sach-quy-dinh mb-0 text-white-50 ps-3">
                        <li><strong>Quản lý:</strong> Toàn quyền xem tất cả các màn hình.</li>
                        <li><strong>Phục vụ bàn:</strong> Sơ đồ bàn, Gọi món Order POS.</li>
                        <li><strong>Thu ngân:</strong> Sơ đồ bàn, Gọi món Order POS, Kho &amp; Báo cáo.</li>
                        <li><strong>Đầu bếp:</strong> Màn hình Bếp KDS, Kho &amp; Báo cáo.</li>
                    </ul>
                </div>

                <div class="nhom-nut-chuyen-huong d-flex justify-content-center gap-3">
                    @if (User.IsInRole("BEP"))
                    {
                        <a asp-action="ManHinhBep" asp-controller="Home" class="nut-ve-bep btn btn-warning px-4 py-2 fw-bold text-dark">
                            &larr; Về Màn hình Bếp KDS
                        </a>
                    }
                    else
                    {
                        <a asp-action="SoDoBan" asp-controller="Home" class="nut-ve-so-do-ban btn btn-primary px-4 py-2 fw-bold">
                            &larr; Về Sơ đồ bàn làm việc
                        </a>
                    }

                    <a asp-action="Logout" asp-controller="Home" class="nut-doi-tai-khoan btn btn-outline-light px-4 py-2">
                        Đổi tài khoản khác
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
