@using System.Net
@using System.Net.Sockets
@{
    ViewData["Title"] = "Sơ đồ bàn";
    string lanIp = "192.168.0.101";
    try
    {
        var entry = Dns.GetHostEntry(Dns.GetHostName());
        var ip = entry.AddressList.FirstOrDefault(a => a.AddressFamily == AddressFamily.InterNetwork && !IPAddress.IsLoopback(a) && !a.ToString().StartsWith("169.254"));
        if (ip != null) lanIp = ip.ToString();
    }
    catch { }
}

<div class="table-map-page">
    <section class="table-map-panel">
        <div class="table-map-heading">
            <div>
                <h1>Sơ đồ bàn</h1>
                <p id="table-summary">Đang tải danh sách bàn...</p>
            </div>
            <div class="table-map-legend" aria-label="Chú giải trạng thái bàn">
                <span><i class="legend-dot status-empty"></i>Trống</span>
                <span><i class="legend-dot status-serving"></i>Đang phục vụ</span>
                <span><i class="legend-dot status-checkout"></i>Chờ thanh toán</span>
            </div>
        </div>

        <div id="table-grid" class="table-grid" aria-live="polite">
            <div class="table-loading">Đang tải bàn...</div>
        </div>

        <div class="table-toolbar">
            <div class="toolbar-field area-field">
                <label for="area-filter">Lọc khu vực</label>
                <select id="area-filter" class="form-select">
                    <option value="">Tất cả khu vực</option>
                </select>
            </div>
            <button type="button" class="pos-action-button action-blue" id="transfer-table">Chuyển bàn</button>
            <button type="button" class="pos-action-button action-blue" id="merge-table">Gộp bàn</button>
            <div class="toolbar-field status-field">
                <label for="status-select">Trạng thái bàn đã chọn</label>
                <select id="status-select" class="form-select">
                    <option value="TRONG">Trống</option>
                    <option value="DANG_PHUC_VU">Đang phục vụ</option>
                    <option value="CHO_THANH_TOAN">Chờ thanh toán</option>
                    <option value="DA_DAT">Đã đặt</option>
                </select>
            </div>
            <button type="button" class="pos-action-button action-green" id="update-table-status">Cập nhật bàn</button>
            <div id="map-message" class="map-message" role="status" aria-live="polite"></div>
        </div>
    </section>

    <aside class="numpad-panel" aria-label="Bàn phím số để tìm bàn">
        <div class="numpad-heading">
            <h2>Bàn phím số</h2>
            <span id="selected-table-label">Chưa chọn bàn</span>
        </div>
        <label class="numpad-label" for="table-number-search">Tìm theo số hiệu bàn</label>
        <input id="table-number-search" class="numpad-display" type="text" inputmode="none" readonly placeholder="Nhập số bàn" />
        <div class="numpad-keys">
            <button type="button" data-key="1">1</button>
            <button type="button" data-key="2">2</button>
            <button type="button" data-key="3">3</button>
            <button type="button" data-key="4">4</button>
            <button type="button" data-key="5">5</button>
            <button type="button" data-key="6">6</button>
            <button type="button" data-key="7">7</button>
            <button type="button" data-key="8">8</button>
            <button type="button" data-key="9">9</button>
            <button type="button" class="numpad-clear" data-key="clear">C</button>
            <button type="button" data-key="0">0</button>
            <button type="button" class="numpad-delete" data-key="delete">⌫</button>
        </div>
        <button type="button" class="numpad-search" id="clear-table-search">Xóa tìm kiếm</button>
    </aside>
</div>

<div id="table-qr-modal" class="qr-modal" hidden>
    <section class="qr-dialog" role="dialog" aria-modal="true" aria-labelledby="qr-title">
        <button type="button" class="qr-close" id="close-qr-modal" aria-label="&#272;&#243;ng">&times;</button>
        <h2 id="qr-title">M&#227; QR g&#7885;i m&#243;n</h2>
        <p id="qr-table-name" class="qr-table-name"></p>
        <img id="table-qr-image" class="table-qr-image" alt="QR order link" />

        <div style="margin: 12px 0 8px 0; font-size: 12px; text-align: left; background: #f8f9fa; padding: 10px; border-radius: 6px; border: 1px solid #dee2e6;">
            <label for="qr-server-host" style="font-weight: 600; color: #495057; display: block; margin-bottom: 4px;">
                IP máy tính (để điện thoại chung Wi-Fi quét):
            </label>
            <div style="display: flex; gap: 6px;">
                <input type="text" id="qr-server-host" class="form-control form-control-sm" value="@lanIp:5139" placeholder="vd: 192.168.0.101:5139" />
                <button type="button" id="btn-refresh-qr-ip" class="btn btn-sm btn-primary" style="white-space: nowrap;">Cập nhật</button>
            </div>
            <div id="qr-current-url" style="color: #0d6efd; word-break: break-all; margin-top: 6px; font-size: 11.5px; font-weight: 500;"></div>
        </div>

        <a id="guest-order-preview" class="qr-preview-link" target="_blank" rel="noopener">M&#7903; th&#7917; giao di&#7879;n kh&#225;ch tr&#234;n m&#225;y t&#237;nh</a>
    </section>
</div>

<!-- Modal Chuyển bàn -->
<div id="transfer-modal" class="pos-overlay" hidden>
    <div class="modal-dialog-card">
        <header class="modal-dialog-header">
            <h3><i class="bi bi-arrow-left-right"></i> Chuyển bàn</h3>
            <button type="button" class="modal-dialog-close" data-close-transfer>&times;</button>
        </header>
        <div class="modal-dialog-body">
            <div class="modal-field">
                <label>Bàn chuyển (Hiện tại):</label>
                <input type="text" id="transfer-source-name" class="form-control" readonly />
            </div>
            <div class="modal-field">
                <label for="transfer-target-select">Chọn bàn nhận:</label>
                <select id="transfer-target-select" class="form-select"></select>
            </div>
            <p class="modal-hint">Toàn bộ món và đơn hàng của bàn hiện tại sẽ được chuyển sang bàn nhận.</p>
        </div>
        <footer class="modal-dialog-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-close-transfer>Hủy</button>
            <button type="button" class="btn btn-primary btn-sm" id="btn-confirm-transfer">Xác nhận chuyển bàn</button>
        </footer>
    </div>
</div>

<!-- Modal Gộp bàn -->
<div id="merge-modal" class="pos-overlay" hidden>
    <div class="modal-dialog-card">
        <header class="modal-dialog-header">
            <h3><i class="bi bi-intersect"></i> Gộp bàn</h3>
            <button type="button" class="modal-dialog-close" data-close-merge>&times;</button>
        </header>
        <div class="modal-dialog-body">
            <div class="modal-field">
                <label>Bàn cần gộp (Nguồn):</label>
                <input type="text" id="merge-source-name" class="form-control" readonly />
            </div>
            <div class="modal-field">
                <label for="merge-target-select">Gộp vào bàn (Đích):</label>
                <select id="merge-target-select" class="form-select"></select>
            </div>
            <p class="modal-hint">Tất cả các món của bàn nguồn sẽ được dồn vào bàn đích và bàn nguồn sẽ chuyển về trạng thái Trống.</p>
        </div>
        <footer class="modal-dialog-footer">
            <button type="button" class="btn btn-secondary btn-sm" data-close-merge>Hủy</button>
            <button type="button" class="btn btn-primary btn-sm" id="btn-confirm-merge">Xác nhận gộp bàn</button>
        </footer>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            let tables = [];
            let selectedTableId = null;
            let messageTimer;

            const readValue = (obj, camelName, pascalName) => obj[camelName] ?? obj[pascalName];
            const normalizeStatus = value => {
                const status = (value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase();
                return status === 'TRONG' ? 'TRONG' : status;
            };
            const tableId = table => readValue(table, 'maBan', 'MaBan');
            const tableNumber = table => readValue(table, 'soHieuBan', 'SoHieuBan') || `Bàn ${tableId(table)}`;
            const tableArea = table => readValue(table, 'khuVuc', 'KhuVuc') || 'Chưa phân khu';
            const statusClass = status => ({
                TRONG: 'status-empty',
                DANG_PHUC_VU: 'status-serving',
                CHO_THANH_TOAN: 'status-checkout',
                DA_DAT: 'status-reserved'
            }[normalizeStatus(status)] || 'status-reserved');
            const statusLabel = status => ({
                TRONG: 'Trống',
                DANG_PHUC_VU: 'Đang phục vụ',
                CHO_THANH_TOAN: 'Chờ thanh toán',
                DA_DAT: 'Đã đặt'
            }[normalizeStatus(status)] || (status || 'Chưa xác định'));
            const money = value => new Intl.NumberFormat('vi-VN').format(Number(value || 0)) + ' ₫';

            function showMessage(message, isError = false) {
                const element = $('#map-message');
                element.text(message).toggleClass('message-error', isError).addClass('message-visible');
                window.clearTimeout(messageTimer);
                messageTimer = window.setTimeout(() => element.removeClass('message-visible'), 3500);
            }

            function fillAreas() {
                const areaSelect = $('#area-filter');
                const currentValue = areaSelect.val();
                const areas = [...new Set(tables.map(tableArea))].sort((a, b) => a.localeCompare(b, 'vi'));
                areaSelect.find('option:not(:first)').remove();
                areas.forEach(area => areaSelect.append($('<option>').val(area).text(area)));
                if (areas.includes(currentValue)) areaSelect.val(currentValue);
            }

            function renderTables() {
                const area = $('#area-filter').val();
                const numberQuery = $('#table-number-search').val().trim().toLocaleLowerCase('vi');
                const filtered = tables.filter(table =>
                    (!area || tableArea(table) === area) &&
                    (!numberQuery || tableNumber(table).toLocaleLowerCase('vi').includes(numberQuery)));
                const grid = $('#table-grid').empty();

                if (!filtered.length) {
                    grid.append($('<div class="table-loading">').text('Không tìm thấy bàn phù hợp.'));
                }

                filtered.forEach(table => {
                    const id = tableId(table);
                    const status = normalizeStatus(readValue(table, 'trangThai', 'TrangThai'));
                    const amount = Number(readValue(table, 'tongTienTamTinh', 'TongTienTamTinh') || 0);
                    const card = $('<div class="table-card" role="button" tabindex="0">')
                        .addClass(statusClass(status))
                        .toggleClass('table-selected', Number(id) === Number(selectedTableId))
                        .attr('data-table-id', id)
                        .attr('aria-pressed', Number(id) === Number(selectedTableId))
                        .append($('<span class="table-number">').text(tableNumber(table)))
                        .append($('<span class="table-area">').text(tableArea(table)))
                        .append($('<span class="table-status">').text(statusLabel(status)));

                    if (status === 'DANG_PHUC_VU') {
                        card.append($('<span class="table-total">').text(money(amount)));
                    }
                    card.append($('<button type="button" class="table-qr-button">').text('Mã QR'));

                    grid.append(card);
                });

                const occupiedCount = tables.filter(table => normalizeStatus(readValue(table, 'trangThai', 'TrangThai')) === 'DANG_PHUC_VU').length;
                $('#table-summary').text(`${tables.length} bàn · ${occupiedCount} bàn đang phục vụ`);
                const selected = tables.find(table => Number(tableId(table)) === Number(selectedTableId));
                $('#selected-table-label').text(selected ? `Đã chọn ${tableNumber(selected)}` : 'Chưa chọn bàn');
                if (selected) $('#status-select').val(normalizeStatus(readValue(selected, 'trangThai', 'TrangThai')) || 'TRONG');
            }

            function loadTables() {
                $.ajax({
                    url: '/api/restaurant/tables',
                    method: 'GET',
                    dataType: 'json'
                }).done(response => {
                    if (!response || !response.success) {
                        showMessage(response?.message || 'Không thể tải danh sách bàn.', true);
                        return;
                    }

                    tables = response.data || [];
                    fillAreas();
                    renderTables();
                }).fail(() => {
                    $('#table-grid').empty().append($('<div class="table-loading">').text('Không thể kết nối máy chủ để tải bàn.'));
                    showMessage('Tải danh sách bàn thất bại.', true);
                });
            }

            if (typeof signalR !== 'undefined') {
                const hubConnection = new signalR.HubConnectionBuilder()
                    .withUrl('/restaurantHub')
                    .withAutomaticReconnect()
                    .build();
                hubConnection.on('ReceiveDataUpdate', loadTables);
                hubConnection.start().catch(() => {});
            }

            let lastClickedTableId = null;
            let lastClickTime = 0;

            function goToOrderPOS(tableId) {
                if (tableId) {
                    window.location.href = `/Home/OrderPOS?maBan=${tableId}`;
                }
            }

            $('#table-grid').on('click', '.table-card', function (event) {
                if ($(event.target).closest('.table-qr-button').length) return;
                const clickedId = Number($(this).attr('data-table-id'));
                const now = Date.now();

                // Kiểm tra bấm 2 lần liên tiếp (trong vòng 500ms) để chuyển sang màn hình Order của bàn đó
                if (lastClickedTableId === clickedId && (now - lastClickTime) < 500) {
                    goToOrderPOS(clickedId);
                    return;
                }

                lastClickedTableId = clickedId;
                lastClickTime = now;
                selectedTableId = clickedId;

                // Cập nhật giao diện chọn bàn
                $('#table-grid .table-card').each(function () {
                    const isSelected = Number($(this).attr('data-table-id')) === selectedTableId;
                    $(this).toggleClass('table-selected', isSelected).attr('aria-pressed', isSelected);
                });
                const selected = tables.find(table => Number(tableId(table)) === Number(selectedTableId));
                $('#selected-table-label').text(selected ? `Đã chọn ${tableNumber(selected)}` : 'Chưa chọn bàn');
                if (selected) $('#status-select').val(normalizeStatus(readValue(selected, 'trangThai', 'TrangThai')) || 'TRONG');
            });

            // Bắt sự kiện double-click chuẩn trình duyệt
            $('#table-grid').on('dblclick', '.table-card', function (event) {
                if ($(event.target).closest('.table-qr-button').length) return;
                const clickedId = Number($(this).attr('data-table-id'));
                goToOrderPOS(clickedId);
            });

            $('#table-grid').on('keydown', '.table-card', function (event) {
                if ((event.key === 'Enter' || event.key === ' ') && !$(event.target).closest('.table-qr-button').length) {
                    event.preventDefault();
                    $(this).trigger('click');
                }
            });

            let currentQrTableId = null;

            function updateQrModal() {
                if (!currentQrTableId) return;
                const selectedTable = tables.find(table => Number(tableId(table)) === currentQrTableId);
                let host = $('#qr-server-host').val() ? $('#qr-server-host').val().trim() : '@lanIp:5139';
                if (!host) host = '@lanIp:5139';

                let baseUrl = host.startsWith('http://') || host.startsWith('https://')
                    ? host
                    : `http://${host}`;

                const fullUrl = `${baseUrl.replace(/\/$/, '')}/Home/GuestOrder?maBan=${currentQrTableId}`;

                $('#qr-table-name').text(`Bàn ${tableNumber(selectedTable)}`);
                $('#qr-current-url').text(fullUrl);
                $('#guest-order-preview').attr('href', fullUrl);
                $('#table-qr-image').attr('src', `https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(fullUrl)}`);
                $('#table-qr-modal').prop('hidden', false);
            }

            $('#table-grid').on('click', '.table-qr-button', function (event) {
                event.preventDefault();
                event.stopPropagation();
                const card = $(this).closest('.table-card');
                currentQrTableId = Number(card.attr('data-table-id'));
                updateQrModal();
            });

            $('#btn-refresh-qr-ip').on('click', updateQrModal);
            $('#qr-server-host').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    updateQrModal();
                }
            });

            $('#close-qr-modal').on('click', () => $('#table-qr-modal').prop('hidden', true));
            $('#table-qr-modal').on('click', event => {
                if (event.target === event.currentTarget) $('#table-qr-modal').prop('hidden', true);
            });
            $(document).on('keydown', event => {
                if (event.key === 'Escape') $('#table-qr-modal').prop('hidden', true);
            });

            $('#area-filter').on('change', renderTables);
            $('#table-number-search').on('input', renderTables);

            $('.numpad-keys').on('click', 'button', function () {
                const input = $('#table-number-search');
                const key = $(this).data('key');
                if (key === 'clear') input.val('');
                else if (key === 'delete') input.val(input.val().slice(0, -1));
                else input.val(input.val() + String(key));
                renderTables();
            });

            $('#clear-table-search').on('click', function () {
                $('#table-number-search').val('');
                renderTables();
            });

            $('#update-table-status').on('click', function () {
                if (!selectedTableId) {
                    showMessage('Vui lòng chọn bàn cần cập nhật.', true);
                    return;
                }

                $.ajax({
                    url: '/api/restaurant/tables/status',
                    method: 'PUT',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ maBan: selectedTableId, trangThai: $('#status-select').val() })
                }).done(response => {
                    if (!response || !response.success) {
                        showMessage(response?.message || 'Cập nhật trạng thái bàn thất bại.', true);
                        return;
                    }
                    showMessage(response.message || 'Cập nhật trạng thái bàn thành công.');
                    loadTables();
                }).fail(xhr => {
                    showMessage(xhr.responseJSON?.message || 'Cập nhật trạng thái bàn thất bại.', true);
                });
            });

            // --- XỬ LÝ CHUYỂN BÀN & GỘP BÀN TRONG SƠ ĐỒ BÀN ---
            $('#transfer-table').on('click', function () {
                if (!selectedTableId) {
                    showMessage('Vui lòng chọn bàn cần chuyển trên sơ đồ.', true);
                    return;
                }
                const currentTable = tables.find(t => Number(tableId(t)) === selectedTableId);
                const tableName = currentTable ? `${tableNumber(currentTable)} (${tableArea(currentTable)})` : `Bàn ${selectedTableId}`;
                $('#transfer-source-name').val(tableName);

                const select = $('#transfer-target-select').empty();
                const availableTables = tables.filter(t => Number(tableId(t)) !== selectedTableId);
                if (!availableTables.length) {
                    showMessage('Không có bàn nào khác để chuyển.', true);
                    return;
                }
                availableTables.forEach(t => {
                    const id = tableId(t);
                    const status = normalizeStatus(readValue(t, 'trangThai', 'TrangThai'));
                    const statusStr = statusLabel(status);
                    select.append($('<option>').val(id).text(`${tableNumber(t)} - ${tableArea(t)} [${statusStr}]`));
                });
                $('#transfer-modal').prop('hidden', false);
            });

            $('[data-close-transfer]').on('click', () => $('#transfer-modal').prop('hidden', true));

            $('#btn-confirm-transfer').on('click', function () {
                const sourceId = selectedTableId;
                const targetId = Number($('#transfer-target-select').val());
                if (!sourceId || !targetId || sourceId === targetId) {
                    showMessage('Vui lòng chọn bàn nhận hợp lệ.', true);
                    return;
                }

                $.ajax({
                    url: '/api/restaurant/tables/transfer',
                    method: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ maBanNguon: sourceId, maBanDich: targetId })
                }).done(response => {
                    if (!response?.success) {
                        showMessage(response?.message || 'Chuyển bàn thất bại.', true);
                        return;
                    }
                    $('#transfer-modal').prop('hidden', true);
                    showMessage('Chuyển bàn thành công!');
                    selectedTableId = targetId;
                    loadTables();
                }).fail(xhr => showMessage(xhr.responseJSON?.message || 'Chuyển bàn thất bại.', true));
            });

            $('#merge-table').on('click', function () {
                if (!selectedTableId) {
                    showMessage('Vui lòng chọn bàn cần gộp trên sơ đồ.', true);
                    return;
                }
                const currentTable = tables.find(t => Number(tableId(t)) === selectedTableId);
                const tableName = currentTable ? `${tableNumber(currentTable)} (${tableArea(currentTable)})` : `Bàn ${selectedTableId}`;
                $('#merge-source-name').val(tableName);

                const select = $('#merge-target-select').empty();
                const availableTables = tables.filter(t => Number(tableId(t)) !== selectedTableId);
                if (!availableTables.length) {
                    showMessage('Không có bàn nào khác để gộp.', true);
                    return;
                }
                availableTables.forEach(t => {
                    const id = tableId(t);
                    const status = normalizeStatus(readValue(t, 'trangThai', 'TrangThai'));
                    const statusStr = statusLabel(status);
                    select.append($('<option>').val(id).text(`${tableNumber(t)} - ${tableArea(t)} [${statusStr}]`));
                });
                $('#merge-modal').prop('hidden', false);
            });

            $('[data-close-merge]').on('click', () => $('#merge-modal').prop('hidden', true));

            $('#btn-confirm-merge').on('click', function () {
                const sourceId = selectedTableId;
                const targetId = Number($('#merge-target-select').val());
                if (!sourceId || !targetId || sourceId === targetId) {
                    showMessage('Vui lòng chọn bàn đích hợp lệ.', true);
                    return;
                }

                $.ajax({
                    url: '/api/restaurant/tables/merge',
                    method: 'POST',
                    contentType: 'application/json; charset=utf-8',
                    dataType: 'json',
                    data: JSON.stringify({ maBanNguon: sourceId, maBanDich: targetId })
                }).done(response => {
                    if (!response?.success) {
                        showMessage(response?.message || 'Gộp bàn thất bại.', true);
                        return;
                    }
                    $('#merge-modal').prop('hidden', true);
                    showMessage('Gộp bàn thành công!');
                    selectedTableId = targetId;
                    loadTables();
                }).fail(xhr => showMessage(xhr.responseJSON?.message || 'Gộp bàn thất bại.', true));
            });

            loadTables();
            window.setInterval(loadTables, 30000);
        });
    </script>
}
